#!/usr/bin/env bash
# Usage: bin/create-admin <username> [display name]   (asks for password, any non-empty)
set -euo pipefail
[ $# -ge 1 ] || { echo "usage: bin/create-admin <username> [display name]" >&2; exit 1; }
cd "$(dirname "$0")/.."
read -rsp "password: " pw; echo >&2
printf '%s\n' "$pw" | docker compose exec -T api /app/api create-admin "$@"
