# Copy to .env and change for any non-local use.
POSTGRES_PASSWORD=change-me
# Secret used to hash citizen ids (HMAC). Changing it later makes existing voters unrecognisable.
ID_PEPPER=generate-with-openssl-rand-hex-32
# Exact origin users open in the browser (used for CSRF check)
APP_ORIGIN=http://localhost:8080
# Mock ThaiID login: true only for demos. Production must use real ThaiID.
MOCK_THAIID=true
# Set true behind HTTPS
COOKIE_SECURE=false
